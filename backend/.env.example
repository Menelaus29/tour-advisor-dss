# Port the NestJS server listens on
PORT=3001

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Postgres connection string.
# Supabase: use the Session pooler string, port 5432 (Connect panel in the dashboard):
#   postgres://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
# Local Docker Postgres example:
#   postgresql://postgres:postgres@localhost:5432/tour_dss
DATABASE_URL=
